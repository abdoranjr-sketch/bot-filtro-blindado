# Copie para .env (ou cadastre no painel do servidor). Nunca publique o .env.
# Obrigatórias
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# v5: grupo onde saem entradas, green/red, saudações e resumo (ex: -1001234567890).
# Sem ela, tudo vai para TELEGRAM_CHAT_ID. Descubra com /id no grupo.
TELEGRAM_GROUP_ID=
# v5 opcional: id do usuário admin (padrão = TELEGRAM_CHAT_ID)
TELEGRAM_OWNER_ID=
# v5 opcional: grupo de discussão ligado ao canal (conversa + comandos)
TELEGRAM_DISCUSSION_ID=
# Opcional: odds do MoviOdds. Sem ela, os jogos/resultados vêm grátis do ScoreMondo
# e o filtro usa só a regra "limpo vs derrota" (sem regras de odds).
MOVIODDS_KEY=
# Opcional: chave reserva. Se a principal falhar, o bot usa esta por 30 minutos.
MOVIODDS_KEY_2=
# Opcional: resultados anteriores da Czech Liga Pro (SportsAPI365 via RapidAPI,
# plano gratuito, 50 requisições/dia). O bot usa no máximo 40 e, sem esta chave,
# segue sem as linhas de Histórico 7d e H2H 14d. O H2H, quando existe, é só informação.
SPORTSAPI365_KEY=
# Opcional: veredito curto do Gemini nas entradas aprovadas (1 chamada por bloco).
# Sem a chave, ou se a API falhar/estourar 8s, o alerta sai igual, sem a linha do Gemini.
GEMINI_API_KEY=
# Opcional. Padrão: gemini-2.5-flash. Se falhar, tenta gemini-2.0-flash.
GEMINI_MODEL=gemini-2.5-flash
# Horário anterior: rigido (padrão) bloqueia qualquer jogo nos 45 min anteriores.
# sets bloqueia só se esse jogo teve 4 ou 5 sets.
HORARIO_ANTERIOR=rigido
# Pasta dos arquivos de histórico/cache (use um volume/pasta persistente)
DATA_DIR=/data
